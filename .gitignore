# =============================================================================
# KisanLink AI — .gitignore
# =============================================================================

# --- Virtual Environments (Never commit compiled local libraries) ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Byte-compiled / Optimized Python Files ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# --- Environment Variables & Secrets (CRITICAL) ---
.env
.env.local
.env.*.local
*.pem
*.key

# Preserve example config template
!.env.example

# --- Local Databases & Data Stores ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/*.db
data/*.sqlite

# Ensure seed datasets remain tracked
!data/*.csv

# --- Logs & Process Artifacts ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- IDEs & Editor Configurations ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Agent & Scratch Data ---
.gemini/
scratch/
